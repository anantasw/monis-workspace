# Copy to .env.local for local development. Both values are optional.

# Rent requests are POSTed here as JSON (Slack incoming webhook, Zapier, Make, a CRM). HTTPS only.
RENT_REQUEST_WEBHOOK_URL=

# monis.rent WhatsApp number, digits only, country code first (for example 6281234567890).
# When set, the summary page shows "Send on WhatsApp".
MONIS_WHATSAPP_NUMBER=
